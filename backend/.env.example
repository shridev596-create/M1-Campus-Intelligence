# M1 - Campus Intelligence Environment Configuration

# Backend API Configuration
APP_NAME="M1 - Campus Intelligence"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./campus_intelligence.db"

# LLM Configuration
# Set LLM_PROVIDER to "demo" (default, works without any API key), "gemini", or "openai"
LLM_PROVIDER="demo"

# Set GEMINI_API_KEY if using LLM_PROVIDER="gemini"
GEMINI_API_KEY=""

# Set OPENAI_API_KEY if using LLM_PROVIDER="openai"
OPENAI_API_KEY=""

# Confidence threshold below which complaints are routed to Human Triage
CONFIDENCE_THRESHOLD=0.75

# Similarity threshold for grouping complaints (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.70
